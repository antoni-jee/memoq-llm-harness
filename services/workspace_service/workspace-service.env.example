# workspace-service configuration example. Contains no credentials.
# Copy to a file outside version control (for example workspace-service.env),
# fill in real values there, and load it into the process environment.

# Bind address and port. Use 0.0.0.0 to accept connections from other hosts.
WORKSPACE_SERVICE_HOST=127.0.0.1
WORKSPACE_SERVICE_PORT=8102

# PostgreSQL. Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=MODE
# sslmode: disable | prefer (default) | require | verify-ca | verify-full
WORKSPACE_DATABASE_URL=postgresql://workspace_svc:CHANGE_ME@db.example.internal:5432/harness?sslmode=prefer
WORKSPACE_DB_SCHEMA=workspace
WORKSPACE_DB_TIMEOUT_SECONDS=10

# Request body limit in bytes (default 20 MiB) and log level.
WORKSPACE_MAX_BODY_BYTES=20971520
WORKSPACE_LOG_LEVEL=info
