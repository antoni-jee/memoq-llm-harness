# processing-service configuration example. Contains no credentials.
# Copy to a file outside version control (for example processing-service.env),
# fill in real values there, and load it into the process environment.

# Bind address and port. Use 0.0.0.0 to accept connections from other hosts.
PROCESSING_SERVICE_HOST=127.0.0.1
PROCESSING_SERVICE_PORT=8103

# Engine: stub (default, offline, free) | openai (any OpenAI-compatible
# endpoint, e.g. Ollama) | anthropic. Real engines need requirements-engines.txt
# and may be billable. Clients can only choose "stub" or this engine.
PROCESSING_ENGINE=stub
# Only for real engines:
# PROCESSING_MODEL=qwen2.5:32b-instruct
# PROCESSING_BASE_URL=http://ollama.example.internal:11434/v1
# PROCESSING_API_KEY=CHANGE_ME
# PROCESSING_TIMEOUT_SECONDS=300
# PROCESSING_MAX_RETRIES=3
# PROCESSING_CHUNK_SIZE=20
# PROCESSING_TEMPERATURE=0.2
# PROCESSING_MAX_TOKENS=4096

# Request limits and log level.
PROCESSING_MAX_SEGMENTS=200
PROCESSING_MAX_BODY_BYTES=20971520
PROCESSING_LOG_LEVEL=info
