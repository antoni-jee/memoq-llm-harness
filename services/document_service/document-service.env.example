# document-service configuration example. Contains no credentials.
# Copy to a file outside version control (for example document-service.env),
# fill in real values there, and load it into the process environment.

# Bind address and port. Use 0.0.0.0 to accept connections from other hosts.
DOCUMENT_SERVICE_HOST=127.0.0.1
DOCUMENT_SERVICE_PORT=8101

# PostgreSQL. Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=MODE
# sslmode: disable | prefer (default) | require | verify-ca | verify-full
DOCUMENT_DATABASE_URL=postgresql://document_svc:CHANGE_ME@db.example.internal:5432/harness?sslmode=prefer
DOCUMENT_DB_SCHEMA=document
DOCUMENT_DB_TIMEOUT_SECONDS=10

# Absolute path of the directory holding original files. Only this service
# reads or writes it; it must persist across restarts.
DOCUMENT_STORAGE_DIR=/var/lib/memoq-harness/documents

# Upload limit in bytes (default 50 MiB) and log level.
DOCUMENT_MAX_UPLOAD_BYTES=52428800
DOCUMENT_LOG_LEVEL=info
