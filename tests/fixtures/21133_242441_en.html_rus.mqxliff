<trans-unit id="51" mq:minorversionend="1" mq:minorversionstart="1" mq:status="PreTranslated" mq:percent="101" mq:segmentguid="9f232ee8-6bab-4f33-88c6-5416a6a04101" mq:lastchangedtimestamp="2026-11-17T11:15:07Z" mq:lastchanginguser="antoni_jee" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="23" mq:lastlabel="23" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="true">
<source xml:space="preserve" mq:segpart="23">This requires the introduction of constraints—objective rules that define acceptable market conditions.</source>
<target xml:space="preserve">Для этого необходимо ввести ограничения — объективные правила, определяющие приемлемые рыночные условия.</target>
