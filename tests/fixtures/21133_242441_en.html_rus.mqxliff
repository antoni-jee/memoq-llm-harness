<trans-unit id="415" mq:minorversionend="1" mq:minorversionstart="1" mq:status="PreTranslated" mq:percent="101" mq:segmentguid="8c8a7e06-ad23-4e22-b8ff-e09ed175cbc3" mq:lastchangedtimestamp="2026-11-17T11:15:07Z" mq:lastchanginguser="antoni_jee" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="277" mq:lastlabel="277" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="true">
<source xml:space="preserve" mq:segpart="277">Consistently trading against dominant momentum increases exposure to drawdowns and reduces expectancy.</source>
<target xml:space="preserve">Постоянная торговля против доминирующего импульса повышает подверженность просадкам и снижает математическое ожидание.</target>
<context-group>
<context context-type="x-mmq-structural-context">html / body#1 / div#3 / p#1</context>
</context-group>
<mq:minorversions>
