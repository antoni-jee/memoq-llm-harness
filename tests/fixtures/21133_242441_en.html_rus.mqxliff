<trans-unit id="335" mq:minorversionend="1" mq:minorversionstart="1" mq:status="PreTranslated" mq:percent="101" mq:segmentguid="44e1d19a-8b80-4071-aab0-5b56b28cc20b" mq:lastchangedtimestamp="2026-11-17T11:15:07Z" mq:lastchanginguser="antoni_jee" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="223" mq:lastlabel="223" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="true">
<source xml:space="preserve" mq:segpart="223">The strategy no longer fights the market; it seeks alignment with the prevailing trend before committing capital.</source>
<target xml:space="preserve">Эта стратегия больше не противостоит рынку; она стремится согласоваться с преобладающим трендом, прежде чем задействовать капитал.</target>
