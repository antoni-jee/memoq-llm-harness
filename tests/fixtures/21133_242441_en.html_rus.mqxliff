<trans-unit id="59" mq:minorversionend="1" mq:minorversionstart="1" mq:status="PreTranslated" mq:percent="101" mq:segmentguid="70fa39c2-5ded-4e2f-8bfa-5dbb9ee1c211" mq:lastchangedtimestamp="2026-11-17T11:15:07Z" mq:lastchanginguser="antoni_jee" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="30" mq:lastlabel="30" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="true">
<source xml:space="preserve" mq:segpart="30">To demonstrate the concept, we consider our <bpt id="1" rid="1">&lt;a href=&quot;/en/articles/20986&quot; target=&quot;_blank&quot;&gt;</bpt>liquidity zones indicator<ept id="2" rid="1">&lt;/a&gt;</ept> combined with one of the most widely used trend tools: the 50-period exponential moving average (EMA 50).</source>
<target xml:space="preserve">Чтобы проиллюстрировать эту концепцию, рассмотрим наш <bpt id="3" rid="2">&lt;a href=&quot;/ru/articles/20986&quot; target=&quot;_blank&quot;&gt;</bpt>индикатор зон ликвидности<ept id="2" rid="2">&lt;/a&gt;</ept> в сочетании с одним из наиболее широко используемых инструментов для определения тренда: 50-периодной экспоненциальной скользящей средней (EMA 50).</target>
<context-group>
<context context-type="x-mmq-structural-context">html / body#1 / div#2 / p#13</context>
</context-group>
