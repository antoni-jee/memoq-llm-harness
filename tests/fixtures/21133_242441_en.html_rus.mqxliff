<trans-unit id="17" mq:minorversionend="1" mq:minorversionstart="1" mq:status="PreTranslated" mq:percent="101" mq:segmentguid="a179d6ab-d5c6-4c03-804c-232a004699f9" mq:lastchangedtimestamp="2026-11-17T11:15:07Z" mq:lastchanginguser="antoni_jee" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="13" mq:lastlabel="13" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="true">
<source xml:space="preserve" mq:segpart="13">When the market trends strongly, your system fires signals in both directions, and you find yourself hesitating, unsure whether to trust a pullback or fear a reversal.</source>
<target xml:space="preserve">Когда на рынке формируется сильный тренд, ваша система генерирует сигналы в обоих направлениях, и вы начинаете колебаться, не зная, стоит ли доверять откату или опасаться разворота.</target>
<context-group>
<context context-type="x-mmq-structural-context">html / body#1 / div#2 / p#2</context>
</context-group>
