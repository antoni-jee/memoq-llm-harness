<trans-unit id="417" mq:minorversionend="1" mq:minorversionstart="1" mq:status="PreTranslated" mq:percent="101" mq:segmentguid="7a1b61c4-9c75-43b0-ba69-5616358057b5" mq:lastchangedtimestamp="2026-11-17T11:15:07Z" mq:lastchanginguser="antoni_jee" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="278" mq:lastlabel="278" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="true">
<source xml:space="preserve" mq:segpart="278">In other words, we trade liquidity in the direction of the trend, not against it.</source>
<target xml:space="preserve">Другими словами, мы работаем с ликвидностью в направлении тренда, а не против него.</target>
