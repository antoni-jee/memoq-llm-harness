<source xml:space="preserve" mq:segpart="66" mq:hasfollowingobject="hasfollowingobject">This approach keeps the strategy readable and avoids turning the OnTick() function into a dense collection of conditional rules.</source>
<target xml:space="preserve"></target>
<context-group>
