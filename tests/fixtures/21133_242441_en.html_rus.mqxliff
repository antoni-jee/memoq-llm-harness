<trans-unit id="411" mq:minorversionend="1" mq:minorversionstart="1" mq:status="PreTranslated" mq:percent="101" mq:segmentguid="03beac0d-03bb-4330-a507-c29cf24f411c" mq:lastchangedtimestamp="2026-11-17T11:15:07Z" mq:lastchanginguser="antoni_jee" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="276" mq:lastlabel="276" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="true">
<source xml:space="preserve" mq:segpart="276">The Expert Advisor detects base–impulse candle structures, places layered pending limit orders within liquidity zones, manages execution timing on a per-bar basis, and delegates directional validation to the TrendFilter module for improved trade quality.</source>
<target xml:space="preserve">Советник выявляет структуры из базовой и импульсной свечей, размещает многоуровневые отложенные лимитные ордера в зонах ликвидности, управляет таймингом исполнения на побарной основе и делегирует проверку направления модулю TrendFilter для повышения качества сделок.</target>
<context-group>
<context context-type="x-mmq-structural-context">html / body#1 / div#2 / p#16 / p#19 / p#4 / p#3 / p#4 / p#4 / p#4 / p#3 / p#2 / p#2 / p#19 / table#2 / tbody#1 / tr#2 / td#4</context>
