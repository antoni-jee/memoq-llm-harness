<trans-unit id="18" mq:minorversionend="1" mq:minorversionstart="1" mq:status="PreTranslated" mq:percent="101" mq:segmentguid="0ef81ae2-7595-4b74-a924-8b1eeba635de" mq:lastchangedtimestamp="2026-11-17T11:15:07Z" mq:lastchanginguser="antoni_jee" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="13" mq:lastlabel="13" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="true">
<source xml:space="preserve" mq:segpart="13">You came to this article with a working strategy that lacks a directional anchor—and with it, a sense of anxiety every time price moves decisively.</source>
<target xml:space="preserve">Вы пришли к этой статье с рабочей стратегией, которой не хватает ориентира по направлению, — и вместе с этим испытываете тревогу каждый раз, когда цена движется решительно.</target>
<context-group>
<context context-type="x-mmq-structural-context">html / body#1 / div#2 / p#2</context>
</context-group>
