<trans-unit id="120" mq:minorversionend="1" mq:minorversionstart="1" mq:status="PreTranslated" mq:percent="101" mq:segmentguid="56bff3ca-a6b8-4b05-9e96-c619203b6cf6" mq:lastchangedtimestamp="2026-11-17T11:15:07Z" mq:lastchanginguser="antoni_jee" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="66" mq:lastlabel="66" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="true">
<source xml:space="preserve" mq:segpart="66">Rather than embedding trend checks directly inside the Expert Advisor, I chose to isolate that responsibility into a dedicated filter module.</source>
<target xml:space="preserve">Вместо того чтобы встраивать проверки тренда непосредственно в советник, я решил вынести эту ответственность в отдельный модуль трендового фильтра.</target>
<context-group>
<context context-type="x-mmq-structural-context">html / body#1 / div#2 / p#16 / p#17</context>
</context-group>
<mq:minorversions>
