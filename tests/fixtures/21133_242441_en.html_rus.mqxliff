<trans-unit id="31" mq:minorversionend="1" mq:minorversionstart="1" mq:status="PreTranslated" mq:percent="101" mq:segmentguid="c4e6afb7-4d83-4f65-80b0-538d4db303ab" mq:lastchangedtimestamp="2026-11-17T11:15:07Z" mq:lastchanginguser="antoni_jee" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="16" mq:lastlabel="16" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="true">
<source xml:space="preserve" mq:segpart="16">Without a directional bias, the strategy may feel difficult to control or trust during strong directional markets.</source>
