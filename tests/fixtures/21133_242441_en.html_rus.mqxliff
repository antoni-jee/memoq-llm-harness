<trans-unit id="136" mq:minorversionend="1" mq:minorversionstart="1" mq:status="PreTranslated" mq:percent="101" mq:segmentguid="d67e6e88-9e77-46d9-bd7d-d06efe14850d" mq:lastchangedtimestamp="2026-11-17T11:15:07Z" mq:lastchanginguser="antoni_jee" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="76" mq:lastlabel="76" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="true">
<source xml:space="preserve" mq:segpart="76">This allows the filter to manage its own internal state, particularly the indicator handle, without leaking implementation details into the Expert Advisor.</source>
<target xml:space="preserve">Это позволяет фильтру управлять собственным внутренним состоянием, в частности хэндлом индикатора, не раскрывая детали реализации советнику.</target>
<context-group>
