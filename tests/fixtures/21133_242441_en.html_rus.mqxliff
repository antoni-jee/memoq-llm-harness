<trans-unit id="265" mq:minorversionend="1" mq:minorversionstart="1" mq:status="PreTranslated" mq:percent="101" mq:segmentguid="657a7b8c-2050-465a-b91a-300393959edc" mq:lastchangedtimestamp="2026-11-17T11:15:07Z" mq:lastchanginguser="antoni_jee" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="173" mq:lastlabel="173" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="true">
<source xml:space="preserve" mq:segpart="173">Before any trade logic is evaluated, market conditions such as spread are checked.</source>
<target xml:space="preserve">Прежде чем оценивать какую-либо торговую логику, проверяются рыночные условия, такие как спред.</target>
