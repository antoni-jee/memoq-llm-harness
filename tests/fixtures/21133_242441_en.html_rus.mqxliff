<trans-unit id="342" mq:minorversionend="1" mq:minorversionstart="1" mq:status="PreTranslated" mq:percent="101" mq:segmentguid="fc1aa241-5ce2-4f64-bf6a-2be7b8a91ea2" mq:lastchangedtimestamp="2026-11-17T11:15:07Z" mq:lastchanginguser="antoni_jee" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="226" mq:lastlabel="226" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="true">
<source xml:space="preserve" mq:segpart="226">The liquidity mechanics remain unchanged: zones are still identified, compression is still measured, and orders are still placed with precision.</source>
