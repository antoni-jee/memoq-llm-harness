<trans-unit id="94" mq:minorversionend="1" mq:minorversionstart="1" mq:status="PreTranslated" mq:percent="101" mq:segmentguid="935198d6-07b6-4440-9c26-7bc6f3358578" mq:lastchangedtimestamp="2026-11-17T11:15:07Z" mq:lastchanginguser="antoni_jee" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="48" mq:lastlabel="48" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="true">
<source xml:space="preserve" mq:segpart="48">According to our trend-alignment rule, short opportunities require the supply zone to be positioned below the EMA 50 to confirm bearish bias.</source>
<target xml:space="preserve">Согласно нашему правилу согласования с трендом, для коротких возможностей необходимо, чтобы зона предложения располагалась ниже EMA 50, подтверждая медвежье направленное смещение.</target>
<context-group>
<context context-type="x-mmq-structural-context">html / body#1 / div#2 / p#16 / p#11</context>
</context-group>
<mq:minorversions>
