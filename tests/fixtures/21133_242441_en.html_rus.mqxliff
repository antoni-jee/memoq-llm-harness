<trans-unit id="50" mq:minorversionend="1" mq:minorversionstart="1" mq:status="PreTranslated" mq:percent="101" mq:segmentguid="2e729f07-b06f-4409-aeaa-6a6edb114245" mq:lastchangedtimestamp="2026-11-17T11:15:07Z" mq:lastchanginguser="antoni_jee" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="23" mq:lastlabel="23" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="true">
<source xml:space="preserve" mq:segpart="23">In other words, we trade liquidity in the direction of the trend, not against it.</source>
<target xml:space="preserve">Другими словами, мы работаем с ликвидностью в направлении тренда, а не против него.</target>
<context-group>
<context context-type="x-mmq-structural-context">html / body#1 / div#2 / p#10</context>
</context-group>
